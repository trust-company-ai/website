{
  "rewrites": [
    {
      "source": "/((?!assets/|__viktor_meta\\.json).*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?trustcompany(ai)?\\.org"
        }
      ],
      "destination": "/tcai.html"
    },
    {
      "source": "/((?!assets/|__viktor_meta\\.json).*)",
      "has": [
        {
          "type": "query",
          "key": "site",
          "value": "trustcompanyai"
        }
      ],
      "destination": "/tcai.html"
    },
    {
      "source": "/((?!assets/|__viktor_meta\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?trustcompanyai\\.org"
        }
      ],
      "destination": "https://www.trustcompany.org/:path",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?trustorgs\\.ai"
        }
      ],
      "destination": "https://www.trustcompany.org/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?trustcompany(ai)?\\.org"
        }
      ],
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "site",
          "value": "trustcompanyai"
        }
      ],
      "destination": "/home",
      "permanent": false
    }
  ]
}
